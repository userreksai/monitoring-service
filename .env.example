PORT=8901
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sms_billing_monitor
MYSQL_USER=monitoring
MYSQL_PASSWORD=
# false=普通连接；true=校验系统信任的 TLS 证书（不要使用 skip-verify）。
MYSQL_TLS=false
MYSQL_TIME_ZONE=+08:00
ADMIN_USERNAME=admin
# 已有 user_account 中的 admin 不会被覆盖；新库创建管理员时才需要。
ADMIN_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=http://localhost:8900,http://127.0.0.1:8900
